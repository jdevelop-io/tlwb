:8080 {
	root * /srv
	encode gzip

	@api path /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy collab-server:3000
	}

	@ws path /ws/*
	handle @ws {
		reverse_proxy collab-server:3000
	}

	# Hashed asset filenames change whenever their content does, so a
	# year-long immutable cache is safe.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# HTML documents are not hashed: on redeploy the image is replaced
	# wholesale, so a heuristically cached document could keep pointing
	# at assets that no longer exist. Always revalidate; the ETag makes
	# that cheap.
	@html path / /*.html /b/*
	header @html Cache-Control "no-cache"

	@board path /b/*
	handle @board {
		rewrite * /board.html
		file_server
	}

	handle {
		try_files {path} {path}.html
		file_server
	}
}

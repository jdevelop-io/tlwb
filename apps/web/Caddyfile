# Behind a front proxy on the same host or Docker network (the usual
# TLS-terminating setup), the visitor's address arrives in
# X-Forwarded-For; a private-range peer is the only kind that could be
# such a proxy, so only those are trusted. Each proxied request then
# forwards exactly one address, the resolved client, since the server
# reads the last entry of that header when TRUST_PROXY is set.
{
	servers {
		trusted_proxies static private_ranges
	}
}

:8080 {
	root * /srv
	encode gzip

	@api path /api/*
	handle @api {
		uri strip_prefix /api
		reverse_proxy collab-server:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	@ws path /ws/*
	handle @ws {
		reverse_proxy collab-server:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	@mcp path /mcp /mcp/
	handle @mcp {
		reverse_proxy collab-server:3000 {
			header_up X-Forwarded-For {client_ip}
		}
	}

	# Hashed asset filenames change whenever their content does, so a
	# year-long immutable cache is safe. Served on its own, terminal,
	# handle: an asset a previous deployment shipped but this one no
	# longer has must 404, never fall through to the landing page with
	# an immutable cache header attached to it.
	@assets path /assets/*
	handle @assets {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# HTML documents are not hashed: on redeploy the image is replaced
	# wholesale, so a heuristically cached document could keep pointing
	# at assets that no longer exist. Always revalidate; the ETag makes
	# that cheap. Every non-asset path qualifies, including the fallback
	# pages served below for a route this deployment no longer has.
	@html not path /assets/*
	header @html Cache-Control "no-cache"

	@board path /b/*
	handle @board {
		rewrite * /board.html
		file_server
	}

	handle {
		# Any path that matches neither a static file nor an HTML page,
		# including a page a previous deployment served, falls back to
		# the landing page rather than a 404.
		try_files {path} {path}.html /index.html
		file_server
	}
}
